# TLS and reverse proxy for the web service. The redirect domains are handled at Cloudflare
# (infra/cf_redirects.py); only the canonical host reaches this box.
{$DY_HOST} {
	encode zstd gzip
	# ---- maintenance (ADR 0020) -------------------------------------------------------
	# `touch data/flags/maintenance` turns it on and `rm` turns it off, with no reload: the
	# file matcher is evaluated per request. The toggle lives here rather than in the
	# application because entering maintenance must not depend on the thing that may be
	# broken — and this way it works when `web` will not start at all, which is the case that
	# needs it most.
	@maintenance file {
		root /flags
		try_files maintenance
	}
	# Every response says so, including a 502 from a stopped `web`. This is the
	# machine-readable signal that survives the app being down, which is exactly when a
	# monitor most needs to tell a planned window from an outage (ADR 0020 § 4).
	header @maintenance X-Docketyard-Maintenance "1"
	# /health is deliberately NOT behind the wall: it answers with the record's real freshness
	# throughout, because the record is still being kept and the record-keeping alarm stays
	# armed. Only the reading surface is silenced.
	@maintenance_wall {
		file {
			root /flags
			try_files maintenance
		}
		not path /health
	}
	handle @maintenance_wall {
		# 503 and never 200: a 200 would invite every crawler to index the apology as the
		# content of every address. 503 says *not now*, where 404 would say *not here*, and
		# ADR 0013's permanence is untouched.
		header Retry-After "1800"
		root * /srv/maintenance
		rewrite * /maintenance.html
		file_server {
			status 503
		}
	}

	# the site's headers, deferred (they delete Server) — so they must not match the one
	# path whose framing policy differs, or they would re-apply over it at response time
	@page not path /document/*
	header @page {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		# inline scripts and style attributes are the site's own (preferences, chart widths);
		# nothing external loads, nothing may frame it
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}
	handle /document/* {
		# the bytes at a hash, shown inside the viewer's own frame: this one path may be
		# framed by this site (no X-Frame-Options); it carries no script of ours
		header {
			Strict-Transport-Security "max-age=31536000"
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			Content-Security-Policy "frame-ancestors 'self'"
			Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
			-Server
		}
		reverse_proxy web:8000
	}
	# INCIDENT CONTAINMENT, 2026-09-02 — DELETE THIS BLOCK WITH THE FIX.
	# Every comment page builds its whole docket sheet to read one field off it
	# (`_comment_entry` in web/app.py), so the cost of one page is the size of the docket.
	# FD 35087 holds 12,031 of the record's 34,255 comments, and this site's own sitemap
	# offers all 12,031 addresses to crawlers. Measured 2026-09-02: median 21.5 s a page,
	# p90 25.0 s, and it took production down twice — once for 6 h 52 m, in which the record
	# stopped being kept (coverage gap 1).
	# The block costs a reader nothing they had: those pages already time out unanswered.
	# 503 and not 404 or 410 — the address is permanent (ADR 0013) and will answer again.
	@big_docket_comments path /d/FD-35087/comment/* /d/FD-35087/sub/*/comment/*
	handle @big_docket_comments {
		header Retry-After "86400"
		respond "This comment page is temporarily unavailable while a performance defect is fixed. It has not moved: the docket sheet at /d/FD-35087 still lists this comment, and this address will answer again." 503
	}
	handle /static/* {
		header Cache-Control "public, max-age=604800"
		reverse_proxy web:8000
	}
	reverse_proxy web:8000
	log {
		# no IPs in the access log: reading leaves no trace (ADR 0011)
		output stderr
		format filter {
			wrap console
			fields {
				request>remote_ip delete
				request>client_ip delete
				request>headers>User-Agent delete
				request>headers>Cookie delete
				# what a reader typed is theirs: no query string, whatever its parameter is
				# called, and no Referer (a same-origin click carries the search page's URL)
				request>uri regexp "\?.*$" ""
				request>headers>Referer delete
				resp_headers>Location regexp "\?.*$" ""
			}
		}
	}
}
