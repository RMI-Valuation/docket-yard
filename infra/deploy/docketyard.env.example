# Copy to /srv/docketyard/.env on the instance. Never commit the real file (gitignored).
DY_TAG=v2026.09.1              # the release to run; change it and `docker compose pull && up -d`
DY_HOST=docketyard.org
DY_POLL_EVERY=1800             # seconds between forward passes
DY_S3_BUCKET=docketyard-prod
AWS_REGION=us-east-2            # the bucket's region
DY_SES_REGION=us-east-2         # SES's region; its own setting because one day it may differ
DY_MAIL_FROM=Docket Yard <alerts@docketyard.org>
DY_OPERATOR_EMAIL=                # the weekly traffic digest (docs/traffic.md); empty = none
DY_EMAIL_KEY=                   # `docketyard vault new-key`; also in the password manager, nowhere else
DY_SES_CONFIGURATION_SET=docketyard
DY_SES_FEEDBACK_TOPIC=arn:aws:sns:us-east-2:987980910568:docketyard-ses-feedback
# Lightsail instances cannot carry an IAM instance profile (ADR 0012 assumed one; see
# infra/deploy/README.md). Until that is resolved these are a scoped IAM user's keys: the
# one policy is PutObject/GetObject/ListBucket/DeleteObject on this bucket and nothing else.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# the web tier's own key (IAM user docketyard-web: s3:GetObject on blobs/* and SES send only)
DY_WEB_AWS_ACCESS_KEY_ID=
DY_WEB_AWS_SECRET_ACCESS_KEY=

# --- telemetry (ADR 0019) ------------------------------------------------------------
# Unset, /metrics is a 404 and the alloy profile scrapes nothing: the stack runs exactly as
# it does today. Set them and `docker compose --profile metrics up -d alloy`.
DY_METRICS_TOKEN=               # any long random string; the scraper presents it as a Bearer
GRAFANA_REMOTE_WRITE_URL=       # Grafana Cloud → Prometheus → remote write endpoint
GRAFANA_REMOTE_WRITE_USER=      # the numeric instance id
GRAFANA_REMOTE_WRITE_TOKEN=     # access policy token, scope `metrics:write` and nothing
                                # else — Alloy only writes. Scope the policy's realm to the
                                # one stack, not the org, and give it its own policy so it
                                # can be revoked without touching the sibling platform's.
