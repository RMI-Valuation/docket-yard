[Unit]
Description=Docket Yard: cut the public snapshot (M9)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/srv/docketyard
ExecStart=/usr/bin/docker compose run --rm --no-deps -e DY_EMAIL_KEY= -e AWS_ACCESS_KEY_ID= -e AWS_SECRET_ACCESS_KEY= web dump --out /data/public
