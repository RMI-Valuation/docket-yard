# Normalise line endings so the repo is byte-identical on Windows, macOS and Linux.
# Without this, files authored LF show as modified the moment Git touches them on Windows.
* text=auto eol=lf

# Never touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.sqlite binary
*.woff  binary
*.woff2 binary

# The licence is verbatim upstream text — never normalise, never diff-mangle.
LICENSE -text -diff

# Extracted document text and fixtures are data, not source.
*.jsonl -diff
