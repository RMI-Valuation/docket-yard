// Grafana Alloy on a fleet WORKER (docs/compute-fleet.md § The monitor, and what detection
// means): the box's own vital signs only. The fleet's series come from the coordinator's
// `config.alloy`; a worker scraping them too would write one series under two host labels.
//
//   docker run -d --name fleet-alloy --restart unless-stopped --network host \
//     --env-file /data/docketyard/alloy.env \
//     -v /data/docketyard/alloy:/var/lib/alloy/data \
//     -v /proc:/host/proc:ro -v /sys:/host/sys:ro -v /:/host/root:ro,rslave \
//     -v ~/docket-yard/tools/fleet/config-host.alloy:/etc/alloy/config.alloy:ro \
//     grafana/alloy:v1.10.0 run --storage.path=/var/lib/alloy/data /etc/alloy/config.alloy
//
// Host networking so the exporter reads the box; the host's /proc, /sys and / mounted so it
// reports the BOX's memory and disks, not a container's (production's lesson).

prometheus.exporter.unix "host" {
	// The container's bind mounts by default; the box's own paths where Alloy runs as a plain
	// binary, set in the env file (FLEET_PROCFS=/proc, FLEET_SYSFS=/sys, FLEET_ROOTFS=/). A
	// procfs path that does not exist fails the exporter's build, and v1.10.0 then refuses
	// the whole config and exits 1 (probed in its image, 2026-10-03) — so every series this
	// file sends stops, not only the vitals. The coordinator's move (2026-09-20) needed a
	// rewritten copy of this file until these were variables.
	procfs_path = coalesce(sys.env("FLEET_PROCFS"), "/host/proc")
	sysfs_path  = coalesce(sys.env("FLEET_SYSFS"), "/host/sys")
	rootfs_path = coalesce(sys.env("FLEET_ROOTFS"), "/host/root")

	set_collectors = ["cpu", "loadavg", "meminfo", "filesystem", "diskstats"]
	filesystem {
		mount_points_exclude = "^/(dev|proc|sys|run|var/lib/docker/.+)($|/)"
		fs_types_exclude     = "^(autofs|binfmt_misc|cgroup2?|devpts|devtmpfs|fusectl|overlay|proc|sysfs|tmpfs|tracefs)$"
	}
}

prometheus.scrape "host" {
	targets         = prometheus.exporter.unix.host.targets
	scrape_interval = "60s"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
	// One stack, several writers: the label says which box these came from, so a rule meant
	// for the fleet's node never matches production's, and the other way round.
	external_labels = {
		service = "docket_yard_fleet",
		host    = sys.env("FLEET_HOST"),
	}

	endpoint {
		url = sys.env("GRAFANA_REMOTE_WRITE_URL")

		basic_auth {
			username = sys.env("GRAFANA_REMOTE_WRITE_USER")
			password = sys.env("GRAFANA_REMOTE_WRITE_TOKEN")
		}
	}
}
